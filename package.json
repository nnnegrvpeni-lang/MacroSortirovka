{
  "name": "macro-sorter",
  "version": "1.0.0",
  "description": "Macro Sorter - Premium Auto-Sorting Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.macro.sorter",
    "productName": "Macro Sorter",
    "publish": {
      "provider": "github",
      "owner": "nnnegrvpeni-lang",
      "repo": "MacroSortirovka"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Macro Sorter"
    },
    "files": [
      "**/*",
      "!dist/*"
    ]
  }
}
